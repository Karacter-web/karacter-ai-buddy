# Karacter AI — environment template
# Copy to .env for local development. NEVER commit the real .env.
# In production these are set in the Cloudflare dashboard
# (Workers & Pages > your project > Settings > Variables and Secrets).

# ---- Client (exposed to the browser; publishable values only) ----
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="<supabase-anon-or-publishable-key>"
VITE_SUPABASE_PROJECT_ID="<project-ref>"

# ---- Server (server functions / SSR only; never exposed to the client) ----
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="<supabase-anon-or-publishable-key>"
SUPABASE_PROJECT_ID="<project-ref>"

# Secret — set ONLY as an encrypted secret in Cloudflare, never in a committed file.
# SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# AI gateway key used by the planner (encrypted secret in Cloudflare).
# LOVABLE_API_KEY="<key>"
