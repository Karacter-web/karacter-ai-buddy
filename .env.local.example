# =============================================================================
# Supabase Local Development Configuration
# =============================================================================
#
# This file is for local development with Supabase.
# Copy this to .env.local (which is in .gitignore) and fill in your values.
#
# For production (Cloudflare Workers), set these as encrypted secrets in the
# Cloudflare dashboard: Workers & Pages > your project > Settings > Variables
#
# =============================================================================
# SUPABASE CLI CONNECTION
# =============================================================================
#
# To connect to your Supabase project via CLI:
#   1. Install Supabase CLI: npm install -g supabase
#   2. Login: supabase login
#   3. Link project: supabase link --project-ref kcaemoljtmtcwvibxomc
#
# Or use these environment variables:

# Your Supabase project URL
SUPABASE_URL=https://kcaemoljtmtcwvibxomc.supabase.co

# Your Supabase publishable key (client-side, safe to expose)
VITE_SUPABASE_URL=https://kcaemoljtmtcwvibxomc.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxx

# Your Supabase project reference (used by CLI)
VITE_SUPABASE_PROJECT_ID=kcaemoljtmtcwvibxomc
SUPABASE_PROJECT_ID=kcaemoljtmtcwvibxomc

# =============================================================================
# SUPABASE SERVER-SIDE (Never expose these to client)
# =============================================================================
#
# Set these in Cloudflare Worker secrets for production
# For local dev, you can set them here but NEVER commit this file

# Your Supabase service role key (bypasses RLS, admin access)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxx

# =============================================================================
# OAUTH PROVIDERS
# =============================================================================
#
# OAuth redirect URL - where users return after OAuth flow
# For local dev:
VITE_OAUTH_REDIRECT_URL=http://localhost:3000/auth/callback
OAuth_REDIRECT_URL=http://localhost:3000/auth/callback

# =============================================================================
# AI PROVIDERS
# =============================================================================
#
# For AI functionality (Gemini, Mistral)
# Set these in Cloudflare Worker secrets for production

# Google Gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Mistral
MISTRAL_API_KEY=your-mistral-api-key
MISTRAL_MODEL=mistral-large-latest

# =============================================================================
# CLOUDFLARE
# =============================================================================
#
# For local dev with Wrangler:
CF_ACCOUNT_ID=your-cloudflare-account-id
CF_API_TOKEN=your-cloudflare-api-token
